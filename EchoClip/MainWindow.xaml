<Window x:Class="EchoClip.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:EchoClip.Views"
        Title="EchoClip"
        Width="960" Height="640"
        MinWidth="720" MinHeight="480"
        Background="#1E1F22"
        Foreground="White"
        FontFamily="Segoe UI"
        Closing="Window_Closing">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles.xaml"/>
                <ResourceDictionary Source="Resources/Converters.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>

        <!-- ── Header bar ──────────────────────────────────────────────── -->
        <Border DockPanel.Dock="Top"
                Background="#111214"
                Padding="16,0">
            <Grid Height="52">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#x1F3A4;" FontSize="20" Margin="0,0,8,0"/>
                    <TextBlock Text="EchoClip" FontSize="18" FontWeight="Bold"
                               Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Status indicators (centre) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center">

                    <!-- Buffer status -->
                    <Border CornerRadius="12" Padding="12,5" Margin="0,0,8,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#2B2D31"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBuffering}" Value="True">
                                        <Setter Property="Background" Value="#1A3A29"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#80848E"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBuffering}" Value="True">
                                                <Setter Property="Fill" Value="#23A559"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock FontSize="12" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text"       Value="Buffer off"/>
                                        <Setter Property="Foreground" Value="#80848E"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBuffering}" Value="True">
                                                <Setter Property="Text"       Value="Buffering"/>
                                                <Setter Property="Foreground" Value="#23A559"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Discord status -->
                    <Border CornerRadius="12" Padding="12,5" Margin="0,0,8,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#2B2D31"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsInVoiceCall}" Value="True">
                                        <Setter Property="Background" Value="#1E2156"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#80848E"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDiscordRunning}" Value="True">
                                                <Setter Property="Fill" Value="#5865F2"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock FontSize="12" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text"       Value="Discord not running"/>
                                        <Setter Property="Foreground" Value="#80848E"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDiscordRunning}" Value="True">
                                                <Setter Property="Text"       Value="Discord open"/>
                                                <Setter Property="Foreground" Value="#B5BAC1"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsInVoiceCall}" Value="True">
                                                <Setter Property="Text"       Value="In voice call"/>
                                                <Setter Property="Foreground" Value="#5865F2"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Now playing -->
                    <Border CornerRadius="12" Padding="12,5"
                            Visibility="{Binding IsPlaying, Converter={StaticResource BoolVis}}">
                        <Border.Background>
                            <SolidColorBrush Color="#1A3A29"/>
                        </Border.Background>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x25B6;" FontSize="10" Foreground="#23A559"
                                       Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding NowPlayingName, TargetNullValue='Playing…'}"
                                       FontSize="12" Foreground="#23A559" VerticalAlignment="Center"/>
                            <Button Content="&#x23F9;" Style="{StaticResource BtnGhost}"
                                    Padding="6,2" Margin="8,0,0,0" FontSize="11"
                                    Command="{Binding StopPlaybackCommand}" ToolTip="Stop playback"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Buffer toggle button -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding ToggleBufferingCommand}"
                            Padding="14,7" Margin="0,0,0,0" FontSize="12">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource BtnBase}">
                                <Setter Property="Content"     Value="Start Buffer"/>
                                <Setter Property="Background"  Value="#5865F2"/>
                                <Setter Property="Foreground"  Value="White"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBuffering}" Value="True">
                                        <Setter Property="Content"    Value="Stop Buffer"/>
                                        <Setter Property="Background" Value="#ED4245"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Status bar ──────────────────────────────────────────────── -->
        <Border DockPanel.Dock="Bottom"
                Background="#111214"
                Padding="16,0">
            <Grid Height="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusText}"
                           FontSize="12" Foreground="#80848E"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Volume" FontSize="11" Foreground="#80848E"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Slider Value="{Binding GlobalVolume}"
                            Minimum="0" Maximum="2"
                            Width="100"
                            VerticalAlignment="Center"
                            TickFrequency="0.05"
                            IsSnapToTickEnabled="True"/>
                    <TextBlock Text="{Binding GlobalVolume, StringFormat='{}{0:P0}'}"
                               FontSize="11" Foreground="#B5BAC1"
                               Width="40" TextAlignment="Right"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Tab navigation + content ───────────────────────────────── -->
        <TabControl Style="{StaticResource NavTabControl}"
                    Background="#1E1F22"
                    SelectedIndex="{Binding TabIndex}">

            <TabItem Header="Clips" Style="{StaticResource NavTabItem}">
                <views:ClipManagerView DataContext="{Binding ClipManager}"/>
            </TabItem>

            <TabItem Header="Settings" Style="{StaticResource NavTabItem}">
                <views:SettingsView DataContext="{Binding SettingsVm}"/>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
