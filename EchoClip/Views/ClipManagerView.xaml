<UserControl x:Class="EchoClip.Views.ClipManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:EchoClip.Models"
             Background="Transparent"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/Styles.xaml"/>
                <ResourceDictionary Source="../Resources/Converters.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" MinWidth="160"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── Left panel: categories + clip list ─────────────────────── -->
        <DockPanel Grid.Column="0" Background="{StaticResource SurfaceBrush}">

            <!-- Toolbar -->
            <Border DockPanel.Dock="Top" Padding="10,10,10,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Margin="0,0,6,0"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                <Style.Resources>
                                    <VisualBrush x:Key="WatermarkBrush" AlignmentX="Left"
                                                 AlignmentY="Center" Stretch="None">
                                        <VisualBrush.Visual>
                                            <TextBlock Text="Search clips…" Foreground="#80848E"
                                                       FontSize="12" Margin="8,0,0,0"/>
                                        </VisualBrush.Visual>
                                    </VisualBrush>
                                </Style.Resources>
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background"
                                                Value="{StaticResource {x:Static SystemColors.WindowBrushKey}}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <Button Grid.Column="1" Content="Import"
                            Style="{StaticResource BtnAccent}"
                            Padding="10,5"
                            Command="{Binding ImportCommand}"/>
                </Grid>
            </Border>

            <!-- Category list -->
            <Border DockPanel.Dock="Top" Padding="10,4">
                <StackPanel>
                    <TextBlock Text="FOLDERS" Style="{StaticResource Caption}" Margin="2,0,0,4"/>
                    <ListBox ItemsSource="{Binding Categories}"
                             SelectedItem="{Binding SelectedCategory}"
                             BorderThickness="0" Background="Transparent">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding"         Value="6,4"/>
                                <Setter Property="Cursor"          Value="Hand"/>
                                <Setter Property="Foreground"      Value="{StaticResource TextMutedBrush}"/>
                                <Setter Property="Background"      Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Root" CornerRadius="4"
                                                    Background="{TemplateBinding Background}"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Root" Property="Background"
                                                            Value="{StaticResource CardBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Root" Property="Background"
                                                            Value="{StaticResource AccentBrush}"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontSize="12"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Content="+ New folder" Margin="0,4,0,0"
                            Style="{StaticResource BtnGhost}"
                            HorizontalAlignment="Left"
                            FontSize="12"
                            Command="{Binding AddCategoryCommand}"/>
                </StackPanel>
            </Border>

            <Separator DockPanel.Dock="Top"/>
            <TextBlock DockPanel.Dock="Top" Text="CLIPS" Style="{StaticResource Caption}"
                       Margin="12,4,0,4"/>

            <!-- Clip list — ContextMenu binds via PlacementTarget to reach the VM -->
            <ListBox x:Name="ClipList"
                     DockPanel.Dock="Top"
                     ItemsSource="{Binding Clips}"
                     SelectedItem="{Binding SelectedClip}"
                     ItemContainerStyle="{StaticResource ClipListItem}"
                     Margin="6,0,6,6"
                     VirtualizingPanel.IsVirtualizing="True">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:AudioClip}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="13"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="{Binding DurationDisplay}" FontSize="11"
                                           Foreground="{StaticResource TextFaintBrush}"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="&#x25B6;"
                                    Style="{StaticResource BtnAccent}"
                                    Padding="8,4" FontSize="11"
                                    Command="{Binding DataContext.PlayCommand,
                                        RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>

                <!-- ContextMenu: PlacementTarget is the ListBox, whose DataContext is ClipManagerVM -->
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Play"
                                  Command="{Binding PlacementTarget.DataContext.PlayCommand,
                                      RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem,
                                      RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="Rename"
                                  Command="{Binding PlacementTarget.DataContext.BeginRenameCommand,
                                      RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem,
                                      RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="Move to selected folder"
                                  Command="{Binding PlacementTarget.DataContext.AssignCategoryCommand,
                                      RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <Separator/>
                        <MenuItem Header="Delete"
                                  Command="{Binding PlacementTarget.DataContext.DeleteCommand,
                                      RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem,
                                      RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>
        </DockPanel>

        <!-- ── Splitter ────────────────────────────────────────────────── -->
        <GridSplitter Grid.Column="1" Width="4"
                      HorizontalAlignment="Stretch"
                      Background="{StaticResource BorderBrush}"
                      Cursor="SizeWE"/>

        <!-- ── Right panel ─────────────────────────────────────────────── -->
        <Grid Grid.Column="2" Background="{StaticResource BgBrush}">

            <!-- Empty-state placeholder -->
            <TextBlock Text="Select a clip to see details"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{StaticResource TextFaintBrush}" FontSize="14">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedClip}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Detail panel — visible when a clip is selected -->
            <ScrollViewer x:Name="DetailScroll"
                          VerticalScrollBarVisibility="Auto"
                          Background="Transparent">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedClip}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Hidden"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>

                <!-- StackPanel DataContext = selected AudioClip; reach VM via DetailScroll -->
                <StackPanel Margin="24,20" DataContext="{Binding SelectedClip}">

                    <!-- Clip name + rename row -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- View mode -->
                        <StackPanel Grid.Column="0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Value="True"
                                            Binding="{Binding DataContext.IsRenaming,
                                                ElementName=DetailScroll}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold"
                                       Foreground="White" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding CreatedAt, StringFormat='Saved {0:d MMM yyyy  HH:mm}'}"
                                       Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Rename mode -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Value="True"
                                            Binding="{Binding DataContext.IsRenaming,
                                                ElementName=DetailScroll}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBox Width="220" Margin="0,0,8,0"
                                     Text="{Binding DataContext.RenameText,
                                         ElementName=DetailScroll,
                                         UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Content="Save" Style="{StaticResource BtnAccent}" Padding="10,4"
                                    Command="{Binding DataContext.CommitRenameCommand, ElementName=DetailScroll}"/>
                            <Button Content="Cancel" Margin="6,0,0,0"
                                    Style="{StaticResource BtnGhost}" Padding="8,4"
                                    Command="{Binding DataContext.CancelRenameCommand, ElementName=DetailScroll}"/>
                        </StackPanel>

                        <Button Grid.Column="1" Content="Rename"
                                Style="{StaticResource BtnGhost}" Padding="10,4"
                                VerticalAlignment="Top"
                                Command="{Binding DataContext.BeginRenameCommand, ElementName=DetailScroll}"
                                CommandParameter="{Binding}"/>
                    </Grid>

                    <!-- Info cards -->
                    <WrapPanel Margin="0,0,0,20">
                        <Border Background="{StaticResource CardBrush}" CornerRadius="4"
                                Padding="10,5" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="DURATION" Style="{StaticResource Caption}"/>
                                <TextBlock Text="{Binding DurationDisplay}"
                                           Style="{StaticResource Body}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource CardBrush}" CornerRadius="4"
                                Padding="10,5" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="SIZE" Style="{StaticResource Caption}"/>
                                <TextBlock Text="{Binding SizeDisplay}"
                                           Style="{StaticResource Body}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource CardBrush}" CornerRadius="4"
                                Padding="10,5">
                            <StackPanel>
                                <TextBlock Text="HOTKEY" Style="{StaticResource Caption}"/>
                                <TextBlock Text="{Binding HotkeyBinding, TargetNullValue='None'}"
                                           Style="{StaticResource Body}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>

                    <!-- Playback controls -->
                    <TextBlock Text="PLAYBACK" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                    <WrapPanel Margin="0,0,0,24">
                        <Button Content="&#x25B6;  Play" Style="{StaticResource BtnSuccess}"
                                Margin="0,0,8,0" Padding="18,8"
                                Command="{Binding DataContext.PlayCommand, ElementName=DetailScroll}"
                                CommandParameter="{Binding}"/>
                        <Button Content="&#x23F9;  Stop" Style="{StaticResource BtnGhost}"
                                Padding="16,8"
                                Command="{Binding DataContext.StopCommand, ElementName=DetailScroll}"/>
                    </WrapPanel>

                    <!-- Volume -->
                    <TextBlock Text="CLIP VOLUME" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                    <DockPanel Margin="0,0,0,20">
                        <TextBlock DockPanel.Dock="Right" Width="44" TextAlignment="Right"
                                   Text="{Binding Volume, StringFormat='{}{0:P0}'}"
                                   Style="{StaticResource Body}" VerticalAlignment="Center"/>
                        <Slider Value="{Binding Volume}" Minimum="0" Maximum="2"
                                TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                    </DockPanel>

                    <!-- Fades -->
                    <TextBlock Text="FADES" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Fade in (ms)" Style="{StaticResource Caption}"
                                       Margin="0,0,0,4"/>
                            <TextBox Text="{Binding FadeInMs, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Fade out (ms)" Style="{StaticResource Caption}"
                                       Margin="0,0,0,4"/>
                            <TextBox Text="{Binding FadeOutMs, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Clip hotkey -->
                    <TextBlock Text="CLIP PLAYBACK HOTKEY" Style="{StaticResource H2}"
                               Margin="0,0,0,8"/>
                    <DockPanel Margin="0,0,0,4">
                        <Button DockPanel.Dock="Right" Content="Save changes"
                                Style="{StaticResource BtnAccent}" Padding="12,6"
                                Command="{Binding DataContext.SaveClipChangesCommand,
                                    ElementName=DetailScroll}"/>
                        <TextBox Text="{Binding HotkeyBinding, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,8,0"/>
                    </DockPanel>
                    <TextBlock Text="e.g. F5, Ctrl+1 — press hotkey to play this clip from anywhere"
                               Style="{StaticResource Caption}" Margin="0,0,0,24"/>

                    <!-- Delete -->
                    <Separator/>
                    <Button Content="Delete clip" HorizontalAlignment="Left"
                            Style="{StaticResource BtnDanger}" Padding="14,6" Margin="0,12,0,0"
                            Command="{Binding DataContext.DeleteCommand, ElementName=DetailScroll}"
                            CommandParameter="{Binding DataContext.SelectedClip, ElementName=DetailScroll}"/>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
