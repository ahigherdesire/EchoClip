<UserControl x:Class="EchoClip.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/Styles.xaml"/>
                <ResourceDictionary Source="../Resources/Converters.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  Background="{StaticResource BgBrush}">
        <StackPanel Margin="32,24" MaxWidth="620">

            <TextBlock Text="Settings" Style="{StaticResource H1}" Margin="0,0,0,24"/>

            <!-- ── Audio Devices ──────────────────────────────────────── -->
            <GroupBox Header="AUDIO DEVICES">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Input (Microphone)"
                                   Style="{StaticResource Body}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding InputDevices}"
                                  SelectedItem="{Binding Settings.InputDeviceId}"
                                  Margin="0,0,8,0"/>
                        <Button Grid.Column="2" Content="&#x21BB;" ToolTip="Refresh devices"
                                Style="{StaticResource BtnGhost}" Padding="8,6"
                                Command="{Binding RefreshDevicesCommand}"/>
                    </Grid>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Virtual Mic (VB-CABLE)"
                                   Style="{StaticResource Body}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding OutputDevices}"
                                  SelectedItem="{Binding Settings.VirtualMicDeviceId}"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Monitor Output"
                                   Style="{StaticResource Body}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding OutputDevices}"
                                  SelectedItem="{Binding Settings.MonitorDeviceId}"/>
                    </Grid>
                    <Border Background="#2B2D31" CornerRadius="6" Padding="10,8" Margin="0,12,0,0">
                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#B5BAC1">
                            Set Virtual Mic to your VB-CABLE Input device. Discord should use VB-CABLE Output as its microphone input.
                            Monitor Output lets you hear clips through your speakers while they play.
                        </TextBlock>
                    </Border>
                </StackPanel>
            </GroupBox>

            <!-- ── Hotkeys ────────────────────────────────────────────── -->
            <GroupBox Header="HOTKEYS">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Save clip"
                               Style="{StaticResource Body}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="0" Grid.Column="1">
                        <TextBox Text="{Binding Settings.SaveHotkey, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="e.g. F8, Ctrl+Shift+S" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Emergency mute"
                               Style="{StaticResource Body}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="2" Grid.Column="1">
                        <TextBox Text="{Binding Settings.EmergencyMuteHotkey, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Instantly stops any playback" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <!-- ── Recording ─────────────────────────────────────────── -->
            <GroupBox Header="RECORDING">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Buffer duration"
                                   Style="{StaticResource Body}" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding Settings.BufferSeconds, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="2" Text="seconds (1–60)"
                                   Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Save format"
                                   Style="{StaticResource Body}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <RadioButton Content="WAV" Margin="0,0,16,0"
                                         IsChecked="{Binding Settings.DefaultFormat,
                                             Converter={StaticResource StringEqConverter},
                                             ConverterParameter=wav}"
                                         GroupName="fmt" Foreground="{StaticResource TextBrush}"/>
                            <RadioButton Content="MP3"
                                         IsChecked="{Binding Settings.DefaultFormat,
                                             Converter={StaticResource StringEqConverter},
                                             ConverterParameter=mp3}"
                                         GroupName="fmt" Foreground="{StaticResource TextBrush}"/>
                        </StackPanel>
                    </Grid>
                    <CheckBox Content="Buffer audio only while in a Discord voice call"
                              IsChecked="{Binding Settings.BufferOnlyDuringCall}"/>
                </StackPanel>
            </GroupBox>

            <!-- ── Discord Detection ──────────────────────────────────── -->
            <GroupBox Header="DISCORD DETECTION">
                <StackPanel>
                    <CheckBox Content="Enable Discord process detection"
                              IsChecked="{Binding Settings.EnableDiscordDetection}"
                              Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Discord App Client ID"
                                   Style="{StaticResource Body}" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding Settings.DiscordClientId, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" FontSize="11" Foreground="#B5BAC1">
                        Optional. Register a Discord application at discord.com/developers to get a Client ID.
                        Required for precise voice-call detection via Discord's local RPC.
                        Without it, EchoClip detects Discord by process name only.
                    </TextBlock>
                </StackPanel>
            </GroupBox>

            <!-- ── Storage ───────────────────────────────────────────── -->
            <GroupBox Header="STORAGE">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding Settings.ClipsDirectory, UpdateSourceTrigger=PropertyChanged}"
                             IsReadOnly="True" Margin="0,0,8,0"/>
                    <Button Grid.Column="1" Content="Browse…"
                            Style="{StaticResource BtnGhost}" Padding="10,6"
                            Command="{Binding BrowseClipsFolderCommand}"/>
                </Grid>
            </GroupBox>

            <!-- ── Application ───────────────────────────────────────── -->
            <GroupBox Header="APPLICATION">
                <StackPanel>
                    <CheckBox Content="Start EchoClip with Windows"
                              IsChecked="{Binding Settings.StartWithWindows}"
                              Margin="0,0,0,8"/>
                    <CheckBox Content="Minimize to system tray when closed"
                              IsChecked="{Binding Settings.MinimizeToTray}"/>
                </StackPanel>
            </GroupBox>

            <!-- ── Actions ───────────────────────────────────────────── -->
            <StackPanel Orientation="Horizontal" Margin="0,4,0,32">
                <Button Content="Save Settings"
                        Style="{StaticResource BtnAccent}"
                        Padding="20,9"
                        Margin="0,0,12,0"
                        Command="{Binding SaveCommand}"/>
                <Button Content="Clear All Recordings"
                        Style="{StaticResource BtnDanger}"
                        Padding="16,9"
                        Command="{Binding ClearAllRecordingsCommand}"/>
            </StackPanel>

            <TextBlock Text="{Binding SavedMessage}"
                       Foreground="{StaticResource SuccessBrush}"
                       FontSize="13"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
